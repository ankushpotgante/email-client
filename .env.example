# AuraMail Environment Configuration Example
# Copy this file to .env and fill in your values

# 1. AI Integration
# Get your key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# 2. JWT Authentication Secrets
# Secure random string used to sign backend session tokens
JWT_SECRET=super_secret_auramail_jwt_token_key_19283

# 3. Database Credentials Encryption
# AES Fernet key to encrypt saved IMAP App Passwords. 
# Leave empty to automatically generate a secure key in .env on first launch.
ENCRYPTION_KEY=

# 4. Dev Server Settings
PORT=8000

